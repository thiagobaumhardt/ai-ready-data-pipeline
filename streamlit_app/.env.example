GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=../terraform/keys/your-service-account-key.json

# BigQuery datasets/tables read by the app (defaults match the README's schema)
BQ_AI_METADATA_DATASET=ai_metadata
BQ_SCORECARD_TABLE=ai_readiness_scorecard
BQ_EMBEDDINGS_TABLE=ai_embeddings
BQ_CATALOG_TABLE=ai_catalog

# LLM used by the chat page (Gemini via LangChain)
GOOGLE_API_KEY=your-gemini-api-key
