# Airflow
airflow/logs/*
!airflow/logs/.gitkeep
airflow/.env
airflow/kube/config

# Terraform (secrets/state) — terraform/.gitignore also covers this locally
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/keys/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db
