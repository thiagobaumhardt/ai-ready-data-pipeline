cluster_name                = "airflow-local"
airflow_namespace           = "airflow"
airflow_executor            = "KubernetesExecutor"
airflow_webserver_host_port = 8080
airflow_webserver_node_port = 30080
admin_username               = "admin"
admin_password               = "admin"
admin_email                  = "admin@example.com"

# Fork this repo and point dags_repo_url at your own fork if you plan to
# push changes; the default points at the upstream repo.
# dags_repo_url    = "https://github.com/your-github-user/ai_dataengineering.git"
# dags_repo_branch = "main"

# GCS bucket the fhir DAG writes raw data to.
# Must be the same bucket created by the GCP Terraform root (../variables.tf bucket_name).
gcs_bucket_name = "data-lake"

# GCP project ID (same as the GCP Terraform root's project_id). Per-table
# dataset and write_disposition live in ingestion/config/tables.yml.
gcp_project_id = "your-gcp-project-id"

# Local path to the same service account key used in terraform/keys/.
# Without this, the "encounters" and "load_to_bigquery" tasks run but fail
# when they try to reach GCS/BigQuery.
gcp_credentials_file = "../keys/your-service-account-key.json"
